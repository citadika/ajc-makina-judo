# =====================================================
# JudoCard backend (FastAPI) - variables d'environnement
# =====================================================
#
# Copiez ce fichier en ".env" et ajustez les valeurs si besoin.
# Les valeurs ci-dessous conviennent au développement local avec
# une base PostgreSQL locale nommée "ajc_makina_judo".

# Connexion PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ajc_makina_judo
DB_USERNAME=postgres
DB_PASSWORD=admin1

# Port du serveur backend
SERVER_PORT=8000

# Secret JWT - EN PRODUCTION, remplacez cette valeur par une chaîne
# longue et aléatoire (ex: openssl rand -base64 48). Ne committez
# jamais le vrai secret de production dans Git.
JWT_SECRET=JudoCardSystemSecretKey2026VerySecureKeyForJWT123456789

# Origine(s) autorisées pour le CORS (frontend React/Vite).
# Plusieurs origines : séparez-les par une virgule.
CORS_ALLOWED_ORIGINS=http://localhost:5173
